---
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getCollection } from 'astro:content';
import { t } from '../i18n/translations';
import { filterByLocale } from '../i18n/content';
import { MATERIAL_CATEGORIES } from '../i18n/materialCategories';
import type { Locale } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const allMaterials = await getCollection('materials');
const materials = filterByLocale(allMaterials, locale);

const allExhibitions = await getCollection('exhibitions');
const exhibitionsCount = filterByLocale(allExhibitions, locale).length;
const exhibitionsUrl = locale === 'en' ? '/en/exhibitions' : '/exhibitions';

const counts: Record<string, number> = {};
for (const m of materials) {
  counts[m.data.category] = (counts[m.data.category] || 0) + 1;
}

function countWord(n: number): string {
  if (locale === 'en') return n === 1 ? 'material' : 'materials';
  const mod10 = n % 10;
  const mod100 = n % 100;
  if (mod10 === 1 && mod100 !== 11) return 'матеріал';
  if ([2, 3, 4].includes(mod10) && ![12, 13, 14].includes(mod100)) return 'матеріали';
  return 'матеріалів';
}
---
<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead title={t(locale, 'nav.materials')} description={t(locale, 'nav.materials')} />
    <style>
      h1 { font-size: 2.5rem; margin-bottom: 0.5rem; }
      .subtitle { color: rgb(96, 115, 159); font-size: 1.1rem; margin-bottom: 2.5rem; }
      .tiles-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; max-width: 900px; }
      .tile { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; border-radius: 16px; border: 1px solid rgb(229, 233, 240); background: #fbf9f7; padding: 3rem 1.5rem; text-decoration: none; color: inherit; transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s; min-height: 200px; }
      .tile:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(40, 42, 43, 0.1); border-color: transparent; }
      .tile-icon { font-size: 2.75rem; margin-bottom: 1rem; }
      .tile-title { font-size: 1.3rem; font-weight: 700; margin: 0 0 0.35rem; }
      .tile-desc { font-size: 0.9rem; color: rgb(96, 115, 159); margin: 0 0 0.6rem; line-height: 1.4; }
      .tile-count { font-size: 0.8rem; color: #c0392b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
      .tile--exhibitions { grid-column: 1 / -1; background: linear-gradient(135deg, #c0392b, #8a2418); color: white; }
      .tile--exhibitions .tile-desc { color: rgba(255,255,255,0.85); }
      .tile--exhibitions .tile-count { color: white; }
      @media (max-width: 640px) {
        .tiles-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>{t(locale, 'nav.materials')}</h1>
      <p class="subtitle">
        {locale === 'uk'
          ? 'Галереї, статті, майстер-класи та відео про петриківський розпис'
          : 'Galleries, articles, masterclasses and videos about Petrykivka painting'}
      </p>

      <div class="tiles-grid">
      <a href={exhibitionsUrl} class="tile tile--exhibitions">
      <span class="tile-icon">🖼️</span>
       <p class="tile-title">{locale === 'uk' ? 'Онлайн виставки' : 'Online Exhibitions'}</p>
       <p class="tile-desc">{locale === 'uk' ? 'Тематичні добірки робіт із Галереї з кураторським текстом' : 'Curated selections from the Gallery with curatorial commentary'}</p>
       <span class="tile-count">{exhibitionsCount} {locale === 'uk' ? (exhibitionsCount === 1 ? 'виставка' : 'виставок') : (exhibitionsCount === 1 ? 'exhibition' : 'exhibitions')}</span>
      </a>
        {MATERIAL_CATEGORIES.map(cat => {
          const count = counts[cat.category] || 0;
          const href = locale === 'en' ? `/en/materials/${cat.slug}` : `/materials/${cat.slug}`;
          return (
            <a href={href} class="tile">
              <span class="tile-icon">{cat.icon}</span>
              <p class="tile-title">{locale === 'en' ? cat.en : cat.uk}</p>
              <p class="tile-desc">{locale === 'en' ? cat.descriptionEn : cat.descriptionUk}</p>
              <span class="tile-count">{count} {countWord(count)}</span>
            </a>
          );
        })}
      </div>
    </main>
    <Footer />
  </body>
</html>