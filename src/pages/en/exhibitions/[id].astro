---
import { getCollection } from 'astro:content';
import ExhibitionPage from '../../../components/ExhibitionPage.astro';

export async function getStaticPaths() {
  const all = await getCollection('exhibitions');
  const en = all.filter(e => e.id.startsWith('en/'));
  return en.map(exhibition => ({
    params: { id: exhibition.id.replace('en/', '') },
    props: { exhibition },
  }));
}

const { exhibition } = Astro.props;
---
<ExhibitionPage exhibition={exhibition} locale="en" />